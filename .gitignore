# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Generated at install time (scripts/copy-ffmpeg-core.mjs) from
# node_modules/@ffmpeg/core — a ~31MB WebAssembly binary that must NOT be
# committed to git. Regenerated automatically by the "postinstall" script.
public/ffmpeg-core

